# Overhead — environment
#
# There are only three groups, and you only ever fill in the ones your deployment uses.
# The full picture, with recipes per deployment, is in docs/configuration.md.
#
#   [1] FEED     which live aircraft feed, read by whichever server you run
#   [2] SERVER   how the relay serves (apps/api) — skip entirely if you have no relay
#   [3] WEB      baked into the browser bundle at build time (VITE_*)


# ─── [1] FEED — read by the relay AND by the serverless functions, same names ──────────────────────
# opensky  needs credentials below, and a host OpenSky accepts (it refuses Vercel's network)
# adsblol  no key, ODbL, carries aircraft type and registration in the feed itself
# demo     synthetic traffic, for working offline (relay only)
FEED=adsblol

# How often each watched area is refreshed upstream. The browser is told this value and paces itself,
# dead-reckoning aircraft in between, so raising it costs smoothness but not correctness.
REFRESH_SECONDS=15

# --- only when FEED=opensky ---
# Credentials from your OpenSky account page. Leave blank to use the anonymous quota (400 credits/day).
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# Daily credit budget for the account: anonymous 400, registered 4000, active feeder 8000.
# The relay spends at most a twenty-fourth of this per hour across every area being watched.
OPENSKY_DAILY_CREDITS=4000
# OpenSky state vectors carry no aircraft type or registration, so the relay joins them from OpenSky's
# database (~95 MB, downloaded here on first start). Irrelevant for the other feeds.
AIRCRAFT_DB_CSV=../../data/aircraft-db.csv
AIRCRAFT_DB_AUTO=1
AIRCRAFT_DB_URL=https://s3.opensky-network.org/data-samples/metadata/aircraftDatabase.csv


# ─── [2] SERVER — the relay only (apps/api) ────────────────────────────────────────────────────────
PORT=8787
HOST=0.0.0.0
# Origins allowed to call this relay from a browser. Add your deployed web URL here.
CORS_ORIGIN=https://localhost:5173,http://localhost:5173
# Guard rails: most areas polled at once, how long an area keeps polling after its last viewer leaves,
# and the minimum gap between any two upstream calls.
MAX_ACTIVE_TILES=24
TILE_IDLE_MS=20000
UPSTREAM_MIN_SPACING_MS=1500


# ─── [3] WEB — build-time, in the browser bundle ───────────────────────────────────────────────────
# Where the feed lives. Blank = this same origin, which is right both for the serverless deployment
# and for one host serving the web app and the relay behind a single proxy. Otherwise the relay's URL,
# e.g. https://overhead-api.fly.dev — the WebSocket URL is derived from it.
VITE_API_URL=

# auto (default) asks GET /api/config and uses a WebSocket if the deployment offers one, otherwise
# polls, otherwise shows demo traffic. Set ws or poll only to force one for comparison.
VITE_TRANSPORT=auto

# Where to look when no location has been chosen yet (Heathrow approach over west London).
VITE_DEFAULT_LAT=51.47
VITE_DEFAULT_LON=-0.30
