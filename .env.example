# ---- API (apps/api) ----
PORT=8787
HOST=0.0.0.0
# opensky (live) | demo (synthetic traffic, offline)
AIRCRAFT_PROVIDER=opensky
# OpenSky OAuth2 client credentials from your account page (anonymous if blank: 400 credits/day, 10 s resolution)
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# Daily credit budget for the account: anonymous 400, registered 4000, active feeder 8000. Spread over the day.
OPENSKY_DAILY_CREDITS=4000
POLL_INTERVAL_MS=15000
MAX_ACTIVE_TILES=24
TILE_IDLE_MS=20000
UPSTREAM_MIN_SPACING_MS=1500
CORS_ORIGIN=https://localhost:5173,http://localhost:5173
# OpenSky aircraft database (type, registration, operator per ICAO24). Downloaded here automatically (~94 MB).
AIRCRAFT_DB_CSV=../../data/aircraft-db.csv
AIRCRAFT_DB_AUTO=1
AIRCRAFT_DB_URL=https://s3.opensky-network.org/data-samples/metadata/aircraftDatabase.csv

# ---- Web (apps/web) ----
# Leave blank in dev (Vite proxies /api and /ws to the API) and when one host serves both
VITE_API_URL=
VITE_WS_URL=
# Fallback home when no location was chosen (Heathrow approach over west London)
VITE_DEFAULT_LAT=51.47
VITE_DEFAULT_LON=-0.30
